msgctxt "Addon Summary"
msgid "Kodi frontend for the NextPVR"
msgstr "Rozhraní Kodi pro NextPVR"

msgctxt "Addon Description"
msgid "NextPVR frontend. Supports streaming of Live TV & Recordings, listening to Radio channels and EPG."
msgstr "Rozhraní NextPVR. Podporuje streamování živé TV a nahrávek, poslech rozhlasových kanálů a EPG."

msgctxt "Addon Disclaimer"
msgid "This is a work in progress. Use at your own risk."
msgstr "Práce na tomto rozhraní stále probíhají. Používejte na vlastní nebezpečí."

